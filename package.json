{
  "name": "elementsplus-wallet-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Experimental security-first ECX Alpha Elements+ browser wallet",
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "npm run build:wasm && node scripts/build.mjs && node scripts/check-artifact.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "node scripts/test.mjs",
    "test:preconf": "cargo test --manifest-path services/preconfer-signer/Cargo.toml",
    "test:monitor": "node --test vendor/elementsplus-preconf/client/monitor.test.mjs",
    "test:monitor:integration": "node --test vendor/elementsplus-preconf/client/integration.test.mjs",
    "test:extension": "node scripts/headless-extension-smoke.mjs",
    "test:live": "node scripts/live-network-smoke.mjs",
    "preview": "node scripts/serve-preview.mjs",
    "check": "npm run typecheck && npm test && npm run test:preconf && npm run test:monitor && npm run build"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
